PORT=3000
FRONTEND_URL=http://localhost:52341
# Comma-separated list of allowed CORS origins. Defaults to FRONTEND_URL if unset -
# only needed if the API must accept requests from more than one origin.
CORS_ORIGINS=
JWT_SECRET=change_me
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_order_system

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=http://localhost:3000/auth/line/callback

# --- Payments (all optional) ---
# Unlike the variables above, these are NOT validated on boot. Leaving them
# empty means the app runs in `manual` mode - the customer pays at the
# counter - rather than refusing to start.
#
# PAYMENT_PROVIDER: manual (default) or tappay. Setting it to tappay without
# a complete key set below silently falls back to manual, so that a missing
# credential can't present a card form that will never work.
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=TWD

# TapPay. APP_ID and APP_KEY are the client-side pair and are sent to the
# browser by design; PARTNER_KEY is the secret and must never be exposed.
# TAPPAY_ENV: sandbox (default) or production.
TAPPAY_ENV=sandbox
TAPPAY_APP_ID=
TAPPAY_APP_KEY=
TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_ID=
